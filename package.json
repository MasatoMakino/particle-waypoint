{
  "name": "@masatomakino/particle-waypoint",
  "version": "0.9.0",
  "description": "Path module for calculating waypoints.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "default": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "types": "./esm/index.d.ts",
  "files": [
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://MasatoMakino@github.com/MasatoMakino/particle-waypoint.git"
  },
  "author": "MasatoMakino <unagiinu.g@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@masatomakino/raf-ticker": "0.5.3 - 0.6.x",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "5.1.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  },
  "scripts": {
    "test": "vitest --run",
    "coverage": "vitest --coverage --run",
    "test:watch": "vitest",
    "pre-commit": "prettier --write --ignore-unknown",
    "pre-push": "pnpm test",
    "build": "pnpm run buildTS",
    "buildTS": "tsc",
    "watch:tsc": "tsc -W -incremental"
  },
  "bugs": {
    "url": "https://github.com/MasatoMakino/particle-waypoint/issues"
  },
  "homepage": "https://github.com/MasatoMakino/particle-waypoint#readme",
  "directories": {
    "lib": "esm"
  }
